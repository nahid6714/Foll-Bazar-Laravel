{
    "name": "fol-bazar/laravel-backend",
    "type": "project",
    "description": "Fol Bazar Laravel API backend",
    "require": {"php":"^8.3","laravel/framework":"^13.0","laravel/sanctum":"^4.0"},
    "require-dev": {"fakerphp/faker":"^1.23","laravel/pint":"^1.24","phpunit/phpunit":"^11.5"},
    "autoload": {"psr-4":{"App\\":"app/","Database\\Factories\\":"database/factories/","Database\\Seeders\\":"database/seeders/"}},
    "autoload-dev":{"psr-4":{"Tests\\":"tests/"}},
    "scripts":{"post-autoload-dump":["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump","@php artisan package:discover --ansi"]},
    "minimum-stability":"stable","prefer-stable":true
}
